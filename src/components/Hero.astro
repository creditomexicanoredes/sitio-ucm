---
interface Props {
  videoSrc?: string;
  imageSrc?: string;
}
const { videoSrc, imageSrc } = Astro.props;
---

<section
  class="relative w-full overflow-hidden"
  style="height: 100vh; min-height: 620px; background: #020b16;"
>
  {
    videoSrc ? (
      <video
        class="absolute inset-0 w-full h-full object-cover"
        autoplay
        muted
        loop
        playsinline
      >
        <source src={videoSrc} type="video/mp4" />
      </video>
    ) : imageSrc ? (
      <img
        src={imageSrc}
        alt=""
        class="absolute inset-0 w-full h-full object-cover"
      />
    ) : null
  }

  <div
    class="absolute inset-0"
    style="background: linear-gradient(105deg, rgba(0,0,0,0.10) 0%, rgba(0,0,0,0.28) 55%, rgba(0,0,0,0.15) 100%);"
  >
  </div>

  <div class="relative z-10 h-full flex flex-row items-center">
    <div class="max-w-[1200px] mb-8 animate-fade-in-up">
      <div
        class="w-full p-15 lg:mx-14 rounded-[4rem] border border-white/10 backdrop-blur-[2px] bg-radial-[at_50%_50%] from-black/5 to-black/17 to-95%"
      >
        <h1
          class="leading-[0.85] tracking-tighter mb-6 text-[#ffffff] font-medium text-[clamp(2.5rem,6vw,4.5rem)]"
        >
          Detrás de cada
          <span class="block">inversión hay una</span>
          <span class="block">
            historia que
            <span class="serif-italic text-[clamp(3rem,7vw,5.25rem)]">
              cuidamos
            </span>
          </span>
        </h1>
      </div>
    </div>
  </div>
</section>
